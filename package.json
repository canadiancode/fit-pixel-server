{
  "name": "fit-pixel-server",
  "version": "1.0.0",
  "description": "Fit Pixel API server for the Expo mobile app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/apply-migration.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canadiancode/fit-pixel-server.git"
  },
  "keywords": [
    "fit-pixel",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/canadiancode/fit-pixel-server/issues"
  },
  "homepage": "https://github.com/canadiancode/fit-pixel-server#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}

{
  "name": "fit-pixel-server",
  "version": "1.0.0",
  "description": "Fit Pixel API server for the Expo mobile app",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "push:worker": "tsx watch src/push-worker.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/apply-migration.mjs",
    "db:check": "node scripts/check-schema.mjs",
    "db:smoke": "node scripts/smoke-connect.mjs",
    "db:push-role": "node scripts/set-role-password.mjs fit_pixel_push PUSH_DATABASE_URL .env \"Run npm run db:sync-droplet-env to deploy it.\"",
    "db:dashboard-role": "node scripts/set-role-password.mjs fit_pixel_dashboard DASHBOARD_DATABASE_URL ../fit-pixel-dashboard/.env.local",
    "db:gym-reviewer-role": "node scripts/set-role-password.mjs fit_pixel_gym_reviewer GYM_REVIEWER_DATABASE_URL ../fit-pixel-dashboard/.env.local \"Restart the dashboard to turn on Approve / Reject.\"",
    "db:sync-droplet-env": "node scripts/sync-droplet-env.mjs",
    "smoke:pilot": "node scripts/pilot-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canadiancode/fit-pixel-server.git"
  },
  "keywords": [
    "fit-pixel",
    "express",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/canadiancode/fit-pixel-server/issues"
  },
  "homepage": "https://github.com/canadiancode/fit-pixel-server#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "morgan": "^1.11.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  }
}

# Server
PORT=3001
# Loopback only (nginx proxies to it). 0.0.0.0 to reach a dev server from a phone on the LAN.
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated browser origins. Empty or * = no browser CORS (native Expo / curl still work).
# Never use * with credentials. Example for Expo web locally:
# CORS_ORIGINS=http://localhost:8081
CORS_ORIGINS=

# FatSecret Platform API (optional — food routes stub until set)
# https://platform.fatsecret.com/api/
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Supabase (required for JWT + sync ingest). Never commit real values.
# Authenticated routes fail closed (503) if SUPABASE_URL + ANON KEY are missing.
# SERVICE_ROLE is local only (smoke / db:check scripts) — not on the droplet,
# never in the Expo app.
# DATABASE_URL is the admin Postgres URI for `npm run db:migrate`. Leave
# `sslmode` out of it: the scripts verify TLS against certs/ themselves.
# PUSH_DATABASE_URL is the push worker's limited login; `npm run db:push-role`
# writes it.
# Fit Pixel project: https://gteamfeljxlpsnaruexq.supabase.co
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUSH_DATABASE_URL=

# Safety alerts: an email to ALERT_EMAIL_TO whenever someone files a report.
# Simplest: send through the Google Workspace inbox with a Google *app
# password* (Google account → Security → 2-Step Verification → App passwords).
# Never put the real password in this file; it goes in .env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Preferred: a Resend API key (resend.com, domain fitpixel.app verified). It
# wins over SMTP, which DigitalOcean blocks on droplets. With neither set,
# alerts are only written to the log.
RESEND_API_KEY=
ALERT_EMAIL_TO=hello@fitpixel.app
ALERT_EMAIL_FROM=Fit Pixel Alerts <alerts@fitpixel.app>

# Push worker (PM2 `fit-pixel-push`) uses PUSH_DATABASE_URL above. Optional Expo access
# token, only if "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
